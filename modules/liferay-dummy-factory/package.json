{
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@liferay/prettier-plugin": "1.1.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "prettier": "3.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "main": "js/index.ts",
  "name": "liferay-dummy-factory",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "checkFormat": "prettier --check \"{src/main/resources/META-INF/resources/js,test,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,json}\" \"*.{js,mjs,cjs,ts,mts,cts,json}\"",
    "format": "prettier --write \"{src/main/resources/META-INF/resources/js,test,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,json}\" \"*.{js,mjs,cjs,ts,mts,cts,json}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "version": "2.0.0"
}
